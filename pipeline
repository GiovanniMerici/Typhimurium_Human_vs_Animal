:\n","    raise ValueError(\"X and y have different numbers of rows.\")\n","\n","if X.shape[0] != df.shape[0]:\n","    raise ValueError(\"X and df have different numbers of rows. Row order must match.\")\n","\n","unique_values = sorted(pd.unique(X.values.ravel()))\n","print(\"Unique feature values:\", unique_values)\n","\n","if not set(unique_values).issubset({0, 1}):\n","    raise ValueError(\"X contains values other than 0 and 1.\")\n","\n","feature_cols = X.columns.tolist()\n","\n","# Save exact input used\n","input_matrix_out = XGB_INPUT_DIR / \"xgboost_input_binary_matrix.tsv\"\n","input_metadata_out = XGB_INPUT_DIR / \"xgboost_input_metadata.tsv\"\n","\n","X_with_id = X.copy()\n","X_with_id.insert(0, \"ID\", df[\"ID\"].astype(str).values)\n","X_with_id.to_csv(input_matrix_out, sep=\"\\t\", index=False)\n","\n","df[[\"ID\", \"Source_Group\"]].to_csv(input_metadata_out, sep=\"\\t\", index=False)\n","\n","print(\"Saved input matrix:\", input_matrix_out)\n","print(\"Saved metadata:\", input_metadata_out)\n","\n","\n","# ============================================================\n","# 3. XGBoost tuning setup\n","# ============================================================\n","\n","N_OUTER_SPLITS = 50\n","TEST_SIZE = 0.2\n","RANDOM_STATE = 42\n","\n","N_ITER_SEARCH = 20\n","INNER_CV_FOLDS = 3\n","\n","outer_splitter = StratifiedShuffleSplit(\n","    n_splits=N_OUTER_SPLITS,\n","    test_size=TEST_SIZE,\n","    random_state=RANDOM_STATE\n",")\n","\n","inner_cv = StratifiedKFold(\n","    n_splits=INNER_CV_FOLDS,\n","    shuffle=True,\n","    random_state=RANDOM_STATE\n",")\n","\n","param_distributions = {\n","    \"n_estimators\": [200, 300, 500, 700],\n","    \"max_depth\": [2, 3, 4, 5, 6],\n","    \"learning_rate\": [0.01, 0.03, 0.05, 0.1],\n","    \"subsample\": [0.6, 0.7, 0.8, 0.9, 1.0],\n","    \"colsample_bytree\": [0.5, 0.6, 0.7, 0.8, 0.9, 1.0],\n","    \"min_child_weight\": [1, 3, 5, 10],\n","    \"gamma\": [0, 0.1, 0.5, 1.0],\n","    \"reg_alpha\": [0, 0.01, 0.1, 1.0],\n","    \"reg_lambda\": [0.5, 1.0, 2.0, 5.0]\n","}\n","\n","base_xgb = XGBClassifier(\n","    objective=\"binary:logistic\",\n","    eval_metric=\"logloss\",\n","    tree_method=\"hist\",\n","    device=\"cuda\",   # change to \"cpu\" if GPU causes problems\n","    random_state=RANDOM_STATE,\n","    n_jobs=-1\n",")\n","\n","\n","# ============================================================\n","# 4. Outer loop: tune, evaluate, SHAP\n","# ============================================================\n","\n","performance_records = []\n","best_param_records = []\n","split_assignment_records = []\n","shap_summary_records = []\n","\n","for split_id, (train_idx, test_idx) in enumerate(outer_splitter.split(X, y), start=1):\n","\n","    print(\"\\n\" + \"=\" * 60)\n","    print(f\"Outer split {split_id}/{N_OUTER_SPLITS}\")\n","    print(\"=\" * 60)\n","\n","    X_train = X.iloc[train_idx].copy()\n","    X_test = X.iloc[test_idx].copy()\n","\n","    y_train = y.iloc[train_idx].copy()\n","    y_test = y.iloc[test_idx].copy()\n","\n","    train_ids = df.iloc[train_idx][\"ID\"].astype(str).tolist()\n","    test_ids = df.iloc[test_idx][\"ID\"].astype(str).tolist()\n","\n","    print(\"Train target counts:\", y_train.value_counts().to_dict())\n","    print(\"Test target counts:\", y_test.value_counts().to_dict())\n","\n","    # --------------------------------------------------------\n","    # Save split membership\n","    # --------------------------------------------------------\n","\n","    for isolate_id, target_value in zip(train_ids, y_train.tolist()):\n","        split_assignment_records.append({\n","            \"split_id\": split_id,\n","            \"ID\": isolate_id,\n","            \"set\": \"train\",\n","            \"target\": int(target_value)\n","        })\n","\n","    for isolate_id, target_value in zip(test_ids, y_test.tolist()):\n","        split_assignment_records.append({\n","            \"split_id\": split_id,\n","            \"ID\": isolate_id,\n","            \"set\": \"test\",\n","            \"target\": int(target_value)\n","        })\n","\n","    # --------------------------------------------------------\n","    # Hyperparameter tuning on training set only\n","    # --------------------------------------------------------\n","\n","    search = RandomizedSearchCV(\n","        estimator=base_xgb,\n","        param_distributions=param_distributions,\n","        n_iter=N_ITER_SEARCH,\n","        scoring=\"roc_auc\",\n","        cv=inner_cv,\n","        verbose=1,\n","        random_state=RANDOM_STATE + split_id,\n","        n_jobs=1,       # safer with GPU\n","        refit=True\n","    )\n","\n","    search.fit(X_train, y_train)\n","\n","    best_model = search.best_estimator_\n","    best_params = search.best_params_\n","\n","    print(\"Best inner-CV ROC-AUC:\", search.best_score_)\n","    print(\"Best parameters:\", best_params)\n","\n","    best_param_record = {\n","        \"split_id\": split_id,\n","        \"inner_cv_best_roc_auc\": float(search.best_score_)\n","    }\n","    best_param_record.update(best_params)\n","    best_param_records.append(best_param_record)\n","\n","    # --------------------------------------------------------\n","    # Held-out test evaluation\n","    # --------------------------------------------------------\n","\n","    y_pred = best_model.predict(X_test)\n","    y_score = best_model.predict_proba(X_test)[:, 1]\n","\n","    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()\n","\n","    split_perf = {\n","        \"split_id\": split_id,\n","        \"n_train\": len(train_idx),\n","        \"n_test\": len(test_idx),\n","        \"train_human\": int((y_train == 1).sum()),\n","        \"train_animal\": int((y_train == 0).sum()),\n","        \"test_human\": int((y_test == 1).sum()),\n","        \"test_animal\": int((y_test == 0).sum()),\n","        \"accuracy\": float(accuracy_score(y_test, y_pred)),\n","        \"balanced_accuracy\": float(balanced_accuracy_score(y_test, y_pred)),\n","        \"roc_auc\": float(roc_auc_score(y_test, y_score)),\n","        \"f1\": float(f1_score(y_test, y_pred)),\n","        \"precision\": float(precision_score(y_test, y_pred)),\n","        \"recall\": float(recall_score(y_test, y_pred)),\n","        \"tn\": int(tn),\n","        \"fp\": int(fp),\n","        \"fn\": int(fn),\n","        \"tp\": int(tp)\n","    }\n","\n","    performance_records.append(split_perf)\n","\n","    print(\"Held-out ROC-AUC:\", split_perf[\"roc_auc\"])\n","    print(\"Held-out balanced accuracy:\", split_perf[\"balanced_accuracy\"])\n","\n","    # --------------------------------------------------------\n","    # SHAP on held-out test isolates\n","    # --------------------------------------------------------\n","\n","    explainer = shap.TreeExplainer(best_model)\n","    shap_values = explainer.shap_values(X_test)\n","\n","    shap_values = np.asarray(shap_values)\n","\n","    # Defensive handling for possible class-specific SHAP output\n","    if shap_values.ndim == 3:\n","        shap_values = shap_values[:, :, 1]\n","\n","    shap_abs = np.abs(shap_values)\n","\n","    split_shap_summary = pd.DataFrame({\n","        \"split_id\": split_id,\n","        \"locus\": feature_cols,\n","        \"mean_abs_shap\": shap_abs.mean(axis=0),\n","        \"median_abs_shap\": np.median(shap_abs, axis=0),\n","        \"max_abs_shap\": shap_abs.max(axis=0),\n","        \"mean_shap\": shap_values.mean(axis=0)\n","    })\n","\n","    shap_summary_records.append(split_shap_summary)\n","\n","    # Save full SHAP matrix for this split\n","    shap_matrix_df = pd.DataFrame(\n","        shap_values,\n","        columns=feature_cols\n","    )\n","    shap_matrix_df.insert(0, \"ID\", test_ids)\n","    shap_matrix_df.insert(1, \"target\", y_test.values)\n","    shap_matrix_df.insert(2, \"split_id\", split_id)\n","\n","    shap_matrix_out = XGB_SHAP_DIR / f\"heldout_shap_matrix_split_{split_id:02d}.tsv\"\n","    shap_matrix_df.to_csv(shap_matrix_out, sep=\"\\t\", index=False)\n","\n","    print(\"Saved SHAP matrix:\", shap_matrix_out)\n","\n","    # --------------------------------------------------------\n","    # Checkpoint after each split\n","    # --------------------------------------------------------\n","\n","    pd.DataFrame(performance_records).to_csv(\n","        CHECKPOINT_PERFORMANCE_OUT,\n","        sep=\"\\t\",\n","        index=False\n","    )\n","\n","    pd.DataFrame(best_param_records).to_csv(\n","        CHECKPOINT_PARAMS_OUT,\n","        sep=\"\\t\",\n","        index=False\n","    )\n","\n","    pd.DataFrame(split_assignment_records).to_csv(\n","        CHECKPOINT_SPLITS_OUT,\n","        sep=\"\\t\",\n","        index=False\n","    )\n","\n","    pd.concat(shap_summary_records, ignore_index=True).to_csv(\n","        CHECKPOINT_SHAP_BY_SPLIT_OUT,\n","        sep=\"\\t\",\n","        index=False\n","    )\n","\n","    print(f\"Checkpoint saved after split {split_id}\")\n","\n","\n","# ============================================================\n","# 5. Save final split-level outputs\n","# ============================================================\n","\n","performance_df = pd.DataFrame(performance_records)\n","best_params_df = pd.DataFrame(best_param_records)\n","split_assignments_df = pd.DataFrame(split_assignment_records)\n","all_shap_summary_df = pd.concat(shap_summary_records, ignore_index=True)\n","\n","performance_df.to_csv(TUNED_RESULTS_OUT, sep=\"\\t\", index=False)\n","best_params_df.to_csv(BEST_PARAMS_OUT, sep=\"\\t\", index=False)\n","split_assignments_df.to_csv(SPLIT_ASSIGNMENTS_OUT, sep=\"\\t\", index=False)\n","all_shap_summary_df.to_csv(SHAP_BY_SPLIT_OUT, sep=\"\\t\", index=False)\n","\n","print(\"Saved performance:\", TUNED_RESULTS_OUT)\n","print(\"Saved best parameters:\", BEST_PARAMS_OUT)\n","print(\"Saved split assignments:\", SPLIT_ASSIGNMENTS_OUT)\n","print(\"Saved SHAP by split:\", SHAP_BY_SPLIT_OUT)\n","\n","\n","# ============================================================\n","# 6. Summarize tuned XGBoost performance\n","# ============================================================\n","\n","metrics = [\n","    \"accuracy\",\n","    \"balanced_accuracy\",\n","    \"roc_auc\",\n","    \"f1\",\n","    \"precision\",\n","    \"recall\"\n","]\n","\n","performance_summary = {\n","    \"n_outer_splits\": N_OUTER_SPLITS,\n","    \"n_successful_splits\": len(performance_df),\n","    \"n_features\": X.shape[1],\n","    \"n_samples\": X.shape[0],\n","    \"n_human\": int((y == 1).sum()),\n","    \"n_animal\": int((y == 0).sum())\n","}\n","\n","for metric in metrics:\n","    performance_summary[f\"{metric}_mean\"] = performance_df[metric].mean()\n","    performance_summary[f\"{metric}_sd\"] = performance_df[metric].std()\n","    performance_summary[f\"{metric}_median\"] = performance_df[metric].median()\n","    performance_summary[f\"{metric}_min\"] = performance_df[metric].min()\n","    performance_summary[f\"{metric}_max\"] = performance_df[metric].max()\n","\n","performance_summary_df = pd.DataFrame([performance_summary])\n","\n","performance_summary_df.to_csv(\n","    PERFORMANCE_SUMMARY_OUT,\n","    sep=\"\\t\",\n","    index=False\n",")\n","\n","print(\"Saved performance summary:\", PERFORMANCE_SUMMARY_OUT)\n","display(performance_summary_df)\n","\n","\n","# ============================================================\n","# 7. Aggregate SHAP across outer splits\n","# ============================================================\n","\n","# Rank loci within each split\n","all_shap_summary_df[\"rank_mean_abs_shap_within_split\"] = (\n","    all_shap_summary_df\n","    .groupby(\"split_id\")[\"mean_abs_shap\"]\n","    .rank(method=\"min\", ascending=False)\n",")\n","\n","# Aggregate across splits\n","shap_agg = (\n","    all_shap_summary_df\n","    .groupby(\"locus\")\n","    .agg(\n","        mean_abs_shap_mean=(\"mean_abs_shap\", \"mean\"),\n","        mean_abs_shap_sd=(\"mean_abs_shap\", \"std\"),\n","        mean_abs_shap_median=(\"mean_abs_shap\", \"median\"),\n","        median_abs_shap_mean=(\"median_abs_shap\", \"mean\"),\n","        max_abs_shap_mean=(\"max_abs_shap\", \"mean\"),\n","        mean_shap_mean=(\"mean_shap\", \"mean\"),\n","        mean_rank=(\"rank_mean_abs_shap_within_split\", \"mean\"),\n","        median_rank=(\"rank_mean_abs_shap_within_split\", \"median\"),\n","        best_rank=(\"rank_mean_abs_shap_within_split\", \"min\")\n","    )\n","    .reset_index()\n",")\n","\n","# Stability: how often each locus appears in the top N per split\n","for top_n in [10, 25, 50, 100]:\n","    top_counts = (\n","        all_shap_summary_df[\n","            all_shap_summary_df[\"rank_mean_abs_shap_within_split\"] <= top_n\n","        ]\n","        .groupby(\"locus\")\n","        .size()\n","    )\n","\n","    shap_agg[f\"frequency_top_{top_n}\"] = (\n","        shap_agg[\"locus\"].map(top_counts).fillna(0).astype(int)\n","    )\n","\n","    shap_agg[f\"proportion_top_{top_n}\"] = (\n","        shap_agg[f\"frequency_top_{top_n}\"] / N_OUTER_SPLITS\n","    )\n","\n","# Sort final SHAP table\n","shap_agg = shap_agg.sort_values(\n","    by=[\"mean_abs_shap_mean\", \"proportion_top_50\", \"mean_rank\"],\n","    ascending=[False, False, True]\n",")\n","\n","shap_agg.to_csv(SHAP_SUMMARY_OUT, sep=\"\\t\", index=False)\n","\n","top_loci = shap_agg.head(100).copy()\n","top_loci.to_csv(SHAP_TOP_OUT, sep=\"\\t\", index=False)\n","\n","print(\"Saved SHAP summary:\", SHAP_SUMMARY_OUT)\n","print(\"Saved top loci:\", SHAP_TOP_OUT)\n","display(top_loci.head(30))\n","\n","\n","# ============================================================\n","# 8. Add direction: Human- or Animal-enriched presence\n","# ============================================================\n","\n","direction_records = []\n","\n","for locus in shap_agg[\"locus\"]:\n","    values = X[locus]\n","\n","    human_presence = values[y == 1].mean()\n","    animal_presence = values[y == 0].mean()\n","\n","    diff = human_presence - animal_presence\n","\n","    if diff > 0:\n","        enriched_in = \"Human\"\n","    elif diff < 0:\n","        enriched_in = \"Animal\"\n","    else:\n","        enriched_in = \"No difference\"\n","\n","    direction_records.append({\n","        \"locus\": locus,\n","        \"human_presence_frequency\": float(human_presence),\n","        \"animal_presence_frequency\": float(animal_presence),\n","        \"human_minus_animal_presence_frequency\": float(diff),\n","        \"enriched_in\": enriched_in\n","    })\n","\n","direction_df = pd.DataFrame(direction_records)\n","\n","shap_agg_direction = shap_agg.merge(\n","    direction_df,\n","    on=\"locus\",\n","    how=\"left\"\n",")\n","\n","shap_agg_direction.to_csv(\n","    SHAP_SUMMARY_DIRECTION_OUT,\n","    sep=\"\\t\",\n","    index=False\n",")\n","\n","print(\"Saved SHAP summary with direction:\", SHAP_SUMMARY_DIRECTION_OUT)\n","display(shap_agg_direction.head(30))\n","\n","\n","# ============================================================\n","# 9. Save run information\n","# ============================================================\n","\n","run_info = {\n","    \"analysis\": \"Tuned XGBoost with held-out SHAP feature ranking\",\n","    \"n_samples\": int(X.shape[0]),\n","    \"n_features\": int(X.shape[1]),\n","    \"target\": \"Human vs animal reservoir\",\n","    \"target_encoding\": {\n","        \"animal_pooled\": 0,\n","        \"human\": 1\n","    },\n","    \"n_human\": int((y == 1).sum()),\n","    \"n_animal\": int((y == 0).sum()),\n","    \"n_outer_splits\": int(N_OUTER_SPLITS),\n","    \"outer_test_size\": float(TEST_SIZE),\n","    \"outer_split_strategy\": \"Repeated stratified train/test splits stratified by binary Human/Animal target\",\n","    \"inner_cv_folds\": int(INNER_CV_FOLDS),\n","    \"hyperparameter_search\": \"RandomizedSearchCV\",\n","    \"n_iter_search\": int(N_ITER_SEARCH),\n","    \"tuning_scoring\": \"roc_auc\",\n","    \"xgboost_base_settings\": {\n","        \"objective\": \"binary:logistic\",\n","        \"eval_metric\": \"logloss\",\n","        \"tree_method\": \"hist\",\n","        \"device\": \"cuda\",\n","        \"random_state\": int(RANDOM_STATE)\n","    },\n","    \"shap_method\": \"TreeExplainer\",\n","    \"shap_samples\": \"held-out test isolates from each outer split\",\n","    \"outputs\": {\n","        \"input_matrix\": str(input_matrix_out),\n","        \"input_metadata\": str(input_metadata_out),\n","        \"performance\": str(TUNED_RESULTS_OUT),\n","        \"performance_summary\": str(PERFORMANCE_SUMMARY_OUT),\n","        \"best_parameters\": str(BEST_PARAMS_OUT),\n","        \"split_assignments\": str(SPLIT_ASSIGNMENTS_OUT),\n","        \"shap_by_split\": str(SHAP_BY_SPLIT_OUT),\n","        \"shap_summary\": str(SHAP_SUMMARY_OUT),\n","        \"shap_top_loci\": str(SHAP_TOP_OUT),\n","        \"shap_summary_with_direction\": str(SHAP_SUMMARY_DIRECTION_OUT)\n","    }\n","}\n","\n","with open(RUN_INFO_OUT, \"w\") as f:\n","    json.dump(run_info, f, indent=4)\n","\n","print(\"Saved run info:\", RUN_INFO_OUT)\n","\n","\n","# ============================================================\n","# 10. Final key outputs\n","# ============================================================\n","\n","print(\"\\nKey outputs\")\n","print(\"-----------\")\n","print(\"Performance summary:\")\n","print(PERFORMANCE_SUMMARY_OUT)\n","\n","print(\"\\nBest parameters by split:\")\n","print(BEST_PARAMS_OUT)\n","\n","print(\"\\nSHAP summary with direction:\")\n","print(SHAP_SUMMARY_DIRECTION_OUT)\n","\n","print(\"\\nTop 100 SHAP loci:\")\n","print(SHAP_TOP_OUT)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"HaMoBOfBXQEM"},"outputs":[],"source":["import pandas as pd\n","shap_summary = pd.read_csv(\n","    \"/content/drive/MyDrive/Salmonella_typhimurium_NA/ml/xgboost_tuned_shap/shap/heldout_shap_locus_summary.tsv\",\n","    sep=\"\\t\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https
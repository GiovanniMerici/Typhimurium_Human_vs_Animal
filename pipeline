er, exist_ok=True)\n","\n","# ----------------------------\n","# 3. Prepare dataframe\n","# ----------------------------\n","df = shap_with_source_and_st_presence.copy()\n","\n","df[\"Description\"] = df[\"Description\"].astype(str).str.strip()\n","\n","df_topic = df[\n","    df[\"Description\"].notna()\n","    & (df[\"Description\"] != \"\")\n","    & (df[\"Description\"].str.lower() != \"nan\")\n","].copy()\n","\n","docs = df_topic[\"Description\"].tolist()\n","\n","print(\"Descriptions used:\", len(docs))\n","print(\"Embedding matrix shape:\", embeddings.shape)\n","\n","# ----------------------------\n","# 4. BERTopic settings\n","# ----------------------------\n","vectorizer_model = CountVectorizer(\n","    stop_words=\"english\",\n","    ngram_range=(1, 3),\n","    min_df=1\n",")\n","\n","umap_model = UMAP(\n","    n_neighbors=15,\n","    n_components=5,\n","    min_dist=0.0,\n","    metric=\"cosine\",\n","    random_state=SEED\n",")\n","\n","hdbscan_model = hdbscan.HDBSCAN(\n","    min_cluster_size=5,\n","    metric=\"euclidean\",\n","    cluster_selection_method=\"eom\",\n","    prediction_data=True\n",")\n","\n","topic_model = BERTopic(\n","    vectorizer_model=vectorizer_model,\n","    umap_model=umap_model,\n","    hdbscan_model=hdbscan_model,\n","    min_topic_size=5,\n","    nr_topics=20,\n","    calculate_probabilities=True,\n","    verbose=True\n",")\n","\n","# ----------------------------\n","# 5. Fit BERTopic\n","# ----------------------------\n","topics, probabilities = topic_model.fit_transform(\n","    docs,\n","    embeddings=embeddings\n",")\n","\n","df_topic[\"bertopic_topic\"] = topics\n","\n","if probabilities is not None:\n","    df_topic[\"bertopic_probability\"] = probabilities.max(axis=1)\n","else:\n","    df_topic[\"bertopic_probability\"] = np.nan\n","\n","topic_info = topic_model.get_topic_info()\n","\n","print(\"Final topic summary:\")\n","display(topic_info)\n","\n","# ----------------------------\n","# 6. Topic labels\n","# ----------------------------\n","def make_topic_label(topic_id, n_words=4):\n","    topic_id = int(topic_id)\n","\n","    if topic_id == -1:\n","        return \"Outlier\"\n","\n","    words = topic_model.get_topic(topic_id)\n","\n","    if words is None:\n","        return f\"Topic {topic_id}\"\n","\n","    top_words = [word for word, score in words[:n_words]]\n","    return \" / \".join(top_words)\n","\n","\n","def make_short_topic_label(topic_id):\n","    topic_id = int(topic_id)\n","\n","    if topic_id == -1:\n","        return \"Outlier\"\n","\n","    words = topic_model.get_topic(topic_id)\n","\n","    if words is None:\n","        return f\"Topic {topic_id}\"\n","\n","    top_words = [word for word, score in words[:2]]\n","    return f\"Topic {topic_id}: \" + \" / \".join(top_words)\n","\n","\n","df_topic[\"bertopic_label\"] = df_topic[\"bertopic_topic\"].apply(make_topic_label)\n","df_topic[\"bertopic_short_label\"] = df_topic[\"bertopic_topic\"].apply(make_short_topic_label)\n","\n","# ----------------------------\n","# 7. 2D UMAP for plotting\n","# ----------------------------\n","umap_2d = UMAP(\n","    n_neighbors=10,\n","    n_components=2,\n","    min_dist=0.1,\n","    metric=\"cosine\",\n","    random_state=SEED\n",")\n","\n","embedding_umap = umap_2d.fit_transform(embeddings)\n","\n","df_topic[\"UMAP_1\"] = embedding_umap[:, 0]\n","df_topic[\"UMAP_2\"] = embedding_umap[:, 1]\n","\n","# ----------------------------\n","# Plot UMAP colored by cluster with outliers as black X\n","# ----------------------------\n","import matplotlib.pyplot as plt\n","import matplotlib.cm as cm\n","import numpy as np\n","import os\n","\n","plot_df = df_topic.copy()\n","plot_df[\"bertopic_topic\"] = plot_df[\"bertopic_topic\"].astype(int)\n","\n","unique_topics = sorted(plot_df[\"bertopic_topic\"].unique())\n","\n","# Separate outliers from real topics\n","has_outliers = -1 in unique_topics\n","cluster_topics = [t for t in unique_topics if t != -1]\n","\n","n_clusters = len(clust
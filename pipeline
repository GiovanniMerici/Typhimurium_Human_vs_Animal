d\n","\n","# Output folder for BERTopic tables\n","bertopic_folder = os.path.join(shap_folder, \"bertopic_outputs\")\n","os.makedirs(bertopic_folder, exist_ok=True)\n","\n","# ------------------------------------------------------------\n","# 1. Save BERTopic get_topic_info()\n","# ------------------------------------------------------------\n","topic_info = topic_model.get_topic_info()\n","\n","topic_info_path = os.path.join(\n","    bertopic_folder,\n","    \"bertopic_nr20_get_topic_info.csv\"\n",")\n","\n","topic_info.to_csv(topic_info_path, index=False)\n","\n","print(\"Saved topic_info:\", topic_info_path)\n","\n","\n","# ------------------------------------------------------------\n","# 2. Save one-row-per-locus topic assignment table\n","# ------------------------------------------------------------\n","assignment_cols = [\n","    \"locus\",\n","    \"Description\",\n","    \"bertopic_topic\",\n","    \"bertopic_label\",\n","    \"bertopic_short_label\",\n","    \"bertopic_probability\"\n","]\n","\n","# Add coordinates if they exist\n","for col in [\"UMAP_1\", \"UMAP_2\", \"TSNE_1\", \"TSNE_2\"]:\n","    if col in df_topic.columns:\n","        assignment_cols.append(col)\n","\n","assignment_cols = [col for col in assignment_cols if col in df_topic.columns]\n","\n","loci_by_cluster_long = (\n","    df_topic[assignment_cols]\n","    .sort_values([\"bertopic_topic\", \"bertopic_probability\"], ascending=[True, False])\n","    .copy()\n",")\n","\n","loci_by_cluster_long_path = os.path.join(\n","    bertopic_folder,\n","    \"bertopic_nr20_loci_by_cluster_long.csv\"\n",")\n","\n","loci_by_cluster_long.to_csv(loci_by_cluster_long_path, index=False)\n","\n","print(\"Saved loci-by-cluster long table:\", loci_by_cluster_long_path)\n","\n","\n","# ------------------------------------------------------------\n","# 3. Save one file per BERTopic cluster\n","# ------------------------------------------------------------\n","cluster_tables_folder = os.path.join(\n","    bertopic_folder,\n","    \"clusters\"\n",")\n","\n","os.makedirs(cluster_tables_folder, exist_ok=True)\n","\n","for topic_id, sub in loci_by_cluster_long.groupby(\"bertopic_topic\"):\n","    topic_id_int = int(topic_id)\n","\n","    if topic_id_int == -1:\n","        file_name = \"cluster_outliers_topic_minus1.csv\"\n","    else:\n","        file_name = f\"cluster_{topic_id_int}.csv\"\n","\n","    cluster_path = os.path.join(cluster_tables_folder, file_name)\n","\n","    sub.to_csv(cluster_path, index=False)\n","\n","print(\"Saved one CSV per cluster in:\", cluster_tables_folder)\n","\n","\n","# ------------------------------------------------------------\n","# 4. Save a compact summary with loci and descriptions per cluster\n","# ------------------------------------------------------------\n","cluster_summary = (\n","    df_topic\n","    .groupby(\"bertopic_topic\")\n","    .agg(\n","        n_loci=(\"locus\", \"count\"),\n","        topic_label=(\"bertopic_label\", \"first\"),\n","        topic_short_label=(\"bertopic_short_label\", \"first\"),\n","        mean_probability=(\"bertopic_probability\", \"mean\"),\n","        loci=(\"locus\", lambda x: \"; \".join(map(str, x))),\n","        descriptions=(\"Description\", lambda x: \" | \".join(map(str, x)))\n","    )\n","    .reset_index()\n","    .sort_values(\"bertopic_topic\")\n",")\n","\n","cluster_summary_path = os.path.join(\n","    bertopic_folder,\n","    \"bertopic_nr20_cluster_summary_with_loci.csv\"\n",")\n","\n","cluster_summary.to_csv(cluster_summary_path, index=False)\n","\n","print(\"Saved cluster summary:\", cluster_summary_path)\n","\n","\n","# ------------------------------------------------------------\n","# 5. Optional: merge topic assignment into full SHAP dataframe and save\n","# ------------------------------------------------------------\n","topic_cols_for_merge = [\n","    \"locus\",\n","    \"bertopic_topic\",\n","    \"bertopic_label\",\n","    \"bertopic_short_label\",\n","    \"bertopic_probability\"\n","]\n","\n","for col in [\"UMAP_1\", \"UMAP_2\", \"TSNE_1\", \"TSNE_2\"]:\n","    if col in df_topic.columns:\n","        topic_cols_for_merge.append(col)\n","\n","topic_cols_for_merge = [col for col in topic_cols_for_merge if col in df_topic.columns]\n","\n","shap_with_bertopic = shap_with_source_and_st_presence.merge(\n","    df_topic[topic_cols_for_merge],\n","    on=\"locus\",\n","    how=\"left\"\n",")\n","\n","shap_with_bertopic_path = os.path.join(\n","    bertopic_folder,\n","    \"shap_with_source_ST_presence_and_bertopic_nr20.csv\"\n",")\n","\n","shap_with_bertopic.to_csv(shap_with_bertopic_path, index=False)\n","\n","print(\"Saved full SHAP table with BERTopic info:\", shap_with_bertopic_path)"]},{"cell_type":"markdown","metadata":{"id":"CwnQaajvYcO2"},"source":["#### ESM3"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":141991,"status":"ok","timestamp":1784104729133,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"},"user_tz":-120},"id":"99hr-vxsOXgF","outputId":"b00f20e9-d9ac-4aef-f1d1-48338119438d"},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m79.5/79.5 kB\u001b[0m \u001b[31m8.9 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m57.4/57.4 kB\u001b[0m \u001b[31m6.7 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m44.4/44.4 kB\u001b[0m \u001b[31m5.2 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m2.5/2.5 MB\u001b[0m \u001b[31m104.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m526.6/526.6 MB\u001b[0m \u001b[31m5.0 M
rive/salmonella_source_attribution_final_merged/wgmlst_allele_fastas\"\n",")\n","\n","# New project output folders\n","PROJECT_DIR = Path(\"/content/drive/MyDrive/Salmonella_typhimurium_NA\")\n","TRUNC_DIR = PROJECT_DIR / \"truncated_wgmlst\"\n","\n","INPUT_DIR = TRUNC_DIR / \"input\"\n","OUTPUT_DIR = TRUNC_DIR / \"output\"\n","QC_DIR = TRUNC_DIR / \"qc\"\n","\n","INPUT_DIR.mkdir(parents=True, exist_ok=True)\n","OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n","QC_DIR.mkdir(parents=True, exist_ok=True)\n","\n","# Output files\n","OUT = OUTPUT_DIR / \"truncated_wgmlst_alleles.tsv\"\n","DONE_FILE = QC_DIR / \"truncated_scan_completed_files.txt\"\n","RUN_INFO_FILE = QC_DIR / \"truncated_scan_run_info.json\"\n","\n","STOP_CODONS = {\"TAA\", \"TAG\", \"TGA\"}\n","\n","# -----------------------------\n","# Load already completed files\n","# -----------------------------\n","\n","if DONE_FILE.exists():\n","    done = set(DONE_FILE.read_text().splitlines())\n","else:\n","    done = set()\n","\n","fasta_files = sorted(FASTA_DIR.glob(\"*.fasta\"))\n","remaining_files = [f for f in fasta_files if f.name not in done]\n","\n","print(f\"Total FASTA files: {len(fasta_files)}\")\n","print(f\"Already completed: {len(done)}\")\n","print(f\"Remaining: {len(remaining_files)}\")\n","\n","# -----------------------------\n","# Create output file if needed\n","# -----------------------------\n","\n","columns = [\n","    \"locus\",\n","    \"allele_id\",\n","    \"fasta_file\",\n","    \"sequence_length_nt\",\n","    \"stop_codon\",\n","    \"stop_codon_index_0based\",\n","    \"stop_codon_number_1based\",\n","    \"stop_nt_start_0based\",\n","    \"stop_nt_start_1based\",\n","    \"truncated_protein_length_aa\",\n","    \"has_terminal_stop\",\n","]\n","\n","if not OUT.exists():\n","    pd.DataFrame(columns=columns).to_csv(OUT, sep=\"\\t\", index=False)\n","\n","# -----------------------------\n","# Scan FASTA files\n","# -----------------------------\n","\n","for fasta_path in tqdm(remaining_files, desc=\"Scanning loci\"):\n","    locus = fasta_path.stem\n","    records = []\n","\n","    for rec in SeqIO.parse(str(fasta_path), \"fasta\"):\n","        allele_id = rec.id\n","        seq = str(rec.seq).upper().replace(\"-\", \"\").replace(\" \", \"\").replace(\"\\n\", \"\")\n","        seq_len = len(seq)\n","\n","        codons = [\n","            seq[i:i + 3]\n","            for i in range(0, seq_len - 2, 3)\n","        ]\n","\n","        if not codons:\n","            continue\n","\n","        has_terminal_stop = codons[-1] in STOP_CODONS\n","\n","        # Internal stop = stop codon before the final complete codon\n","        for codon_index, codon in enumerate(codons[:-1]):\n","            if codon in STOP_CODONS:\n","                records.append({\n","                    \"locus\": locus,\n","                    \"allele_id\": allele_id,\n","                    \"fasta_file\": fasta_path.name,\n","                    \"sequence_length_nt\": seq_len,\n","                    \"stop_codon\": codon,\n","                    \"stop_codon_index_0based\": codon_index,\n","                    \"stop_codon_number_1based\": codon_index + 1,\n","                    \"stop_nt_start_0based\": codon_index * 3,\n","                    \"stop_nt_start_1based\": codon_index * 3 + 1,\n","                    \"truncated_protein_length_aa\": codon_index,\n","                    \"has_terminal_stop\": has_terminal_stop,\n","                })\n","                break\n","\n","    # Append results for this FASTA file\n","    if records:\n","        pd.DataFrame(records).to_csv(\n","            OUT,\n","            sep=\"\\t\",\n","            index=False,\n","            mode=\"a\",\n","            header=False\n","        )\n","\n","    # Mark file as completed only after successful scan/write\n","    with open(DONE_FILE, \"a\") as f:\n","        f.write(fasta_path.name + \"\\n\")\n","\n","# -----------------------------\n","# Save run info\n","# -----------------------------\n","\n","run_info = {\n","    \"fasta_dir\": str(FASTA_DIR),\n","    \"output_dir\": str(OUTPUT_DIR),\n","    \"qc_dir\": str(QC_DIR),\n","    \"truncated_alleles_output\": str(OUT),\n","    \"completed_files_log\": str(DONE_FILE),\n","    \"stop_codons\": sorted(STOP_CODONS),\n","    \"total_fasta_files\": len(fasta_files),\n","    \"already_completed_files_at_start\": len(done),\n","    \"files_scanned_this_run\": len(remaining_files),\n","    \"method_note\": (\n","        \"All allele FASTA files were scanned in frame 0. Internal stop codons were defined as \"\n","        \"TAA, TAG, or TGA occurring before the final complete codon. Terminal stop codons were \"\n","        \"not considered truncating but were recorded as has_terminal_stop.\"\n","    )\n","}\n","\n","with open(RUN_INFO_FILE, \"w\") as f:\n","    json.dump(run_info, f, indent=4)\n","\n","# -----------------------------\n","# Load and summarize results\n","# -----------------------------\n","\n","print(f\"Saved truncated alleles to: {OUT}\")\n","print(f\"Completed file list saved to: {DONE_FILE}\")\n","print(f\"Run info saved to: {RUN_INFO_FILE}\")\n","\n","truncated_df = pd.read_csv(OUT, sep=\"\\t\")\n","\n","print(f\"Truncated alleles found: {len(truncated_df)}\")\n","print(f\"Loci with truncated alleles: {truncated_df['locus'].nunique() if len(truncated_df) else 0}\")\n","\n","truncated_df.head()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":7545,"status":"ok","timestamp":1784024801831,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"},"user_tz":-120},"id":"NwEOrGs0DerZ","outputId":"d48467d9-eb72-4f5f-a7f4-6e85a3a30a5e"},"outputs":[{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_7601/2637900541.py:3: DtypeWarning: Columns (3,9,10) have mixed types. Specify dtype option on import or set low_memory=False.\n","  truncated_df = pd.read_csv(\n"]}],"source":["import pan
n","\n","df[\"ST_top5\"] = df[\"MLST_ST_clean\"].where(\n","    df[\"MLST_ST_clean\"].isin(top5_st),\n","    \"Other STs\"\n",")\n","\n","# Top countries\n","top_countries = df[\"Country_clean\"].value_counts().head(10).index.tolist()\n","\n","df[\"Country_top\"] = df[\"Country_clean\"].where(\n","    df[\"Country_clean\"].isin(top_countries),\n","    \"Other countries\"\n",")\n","\n","# Source colors\n","source_palette = {\n","    \"Human\": \"#0072B2\",\n","    \"Poultry\": \"#E69F00\",\n","    \"Bovine\": \"#009E73\",\n","    \"Swine\": \"#CC79A7\",\n","    \"Animal\": \"#009E73\",\n","    \"Food\": \"#D55E00\",\n","    \"Environment\": \"#8C6D31\",\n","    \"Unknown\": \"#BDBDBD\",\n","    \"Other\": \"#BDBDBD\",\n","}\n","\n","def hex_to_rgba(hex_color, alpha=0.35):\n","    hex_color = hex_color.lstrip(\"#\")\n","    r = int(hex_color[0:2], 16)\n","    g = int(hex_color[2:4], 16)\n","    b = int(hex_color[4:6], 16)\n","    return f\"rgba({r},{g},{b},{alpha})\"\n","\n","# Build links\n","links_1 = (\n","    df.groupby([\"Country_top\", \"Source_clean\"])\n","    .size()\n","    .reset_index(name=\"n\")\n",")\n","\n","links_2 = (\n","    df.groupby([\"Source_clean\", \"ST_top5\"])\n","    .size()\n","    .reset_index(name=\"n\")\n",")\n","\n","countries = links_1[\"Country_top\"].unique().tolist()\n","sources = links_1[\"Source_clean\"].unique().tolist()\n","sts = links_2[\"ST_top5\"].unique().tolist()\n","\n","labels = countries + sources + sts\n","label_to_idx = {label: i for i, label in enumerate(labels)}\n","\n","source_indices = []\n","target_indices = []\n","values = []\n","link_colors = []\n","\n","# Country -> Source links colored by source\n","for _, row in links_1.iterrows():\n","    src = row[\"Source_clean\"]\n","    color = source_palette.get(src, \"#BDBDBD\")\n","\n","    source_indices.append(label_to_idx[row[\"Country_top\"]])\n","    target_indices.append(label_to_idx[src])\n","    values.append(row[\"n\"])\n","    link_colors.append(hex_to_rgba(color, 0.35))\n","\n","# Source -> ST links colored by source\n","for _, row in links_2.iterrows():\n","    src = row[\"Source_clean\"]\n","    color = source_palette.get(src, \"#BDBDBD\")\n","\n","    source_indices.append(label_to_idx[src])\n","    target_indices.append(label_to_idx[row[\"ST_top5\"]])\n","    values.append(row[\"n\"])\n","    link_colors.append(hex_to_rgba(color, 0.35))\n","\n","# Node colors: only Source bars colored; Country and ST bars grey\n","node_colors = []\n","\n","for label in labels:\n","    if label in source_palette:\n","        node_colors.append(source_palette[label])\n","    else:\n","        node_colors.append(\"#D9D9D9\")\n","\n","fig = go.Figure(\n","    data=[\n","        go.Sankey(\n","            arrangement=\"snap\",\n","            node=dict(\n","                pad=14,\n","                thickness=18,\n","                line=dict(color=\"black\", width=0.4),\n","                label=labels,\n","                color=node_colors\n","            ),\n","            link=dict(\n","                source=source_indices,\n","                target=target_indices,\n","                value=values,\n","                color=link_colors\n","            )\n","        )\n","    ]\n",")\n","\n","fig.update_layout(\n","    width=1100,\n","    height=750,\n","    font=dict(size=12, family=\"Arial\"),\n","    margin=dict(l=30, r=30, t=30, b=30)\n",")\n","\n","html_path = f\"{figures_dir}/dataset_country_source_top5st_sankey_source_colored.html\"\n","png_path = f\"{figures_dir}/dataset_country_source_top5st_sankey_source_colored.png\"\n","svg_path = f\"{figures_dir}/dataset_country_source_top5st_sankey_source_colored.svg\"\n","pdf_path = f\"{figures_dir}/dataset_country_source_top5st_sankey_source_colored.pdf\"\n","\n","fig.write_html(html_path)\n","fig.write_image(png_path, scale=3)\n","fig.write_image(svg_path)\n","fig.write_image(pdf_path)\n","\n","fig.show()\n","\n","print(\"Saved:\", html_path)\n","print(\"Saved:\", png_path)\n","p
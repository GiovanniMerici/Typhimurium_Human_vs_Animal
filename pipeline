le-style figures for tuned XGBoost and SHAP results\n","# ============================================================\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from pathlib import Path\n","\n","# ------------------------------------------------------------\n","# 1. Paths\n","# ------------------------------------------------------------\n","\n","base_dir = Path(\"/content/drive/MyDrive/Salmonella_typhimurium_NA/ml/xgboost_tuned_shap\")\n","\n","performance_path = base_dir / \"output/tuned_xgboost_repeated_split_performance.tsv\"\n","performance_summary_path = base_dir / \"output/tuned_xgboost_performance_summary.tsv\"\n","shap_all_path = base_dir / \"shap/heldout_shap_locus_summary_with_direction.tsv\"\n","shap_by_split_path = base_dir / \"shap/heldout_shap_locus_summary_by_split.tsv\"\n","top_loci_path = base_dir / \"shap/heldout_shap_top_loci.tsv\"\n","\n","fig_dir = base_dir / \"figures\"\n","fig_dir.mkdir(parents=True, exist_ok=True)\n","\n","# ------------------------------------------------------------\n","# 2. Load data\n","# ------------------------------------------------------------\n","\n","perf_df = pd.read_csv(performance_path, sep=\"\\t\")\n","perf_summary = pd.read_csv(performance_summary_path, sep=\"\\t\")\n","\n","# This is the dataframe with ALL SHAP loci + direction\n","shap_all = pd.read_csv(shap_all_path, sep=\"\\t\")\n","\n","# SHAP summary by split, useful for rank/stability plots\n","shap_by_split = pd.read_csv(shap_by_split_path, sep=\"\\t\")\n","\n","# Top SHAP loci only\n","shap_top = pd.read_csv(top_loci_path, sep=\"\\t\")\n","\n","print(\"Performance dataframe:\", perf_df.shape)\n","print(\"Performance summary:\", perf_summary.shape)\n","print(\"All SHAP loci dataframe:\", shap_all.shape)\n","print(\"SHAP by split dataframe:\", shap_by_split.shape)\n","print(\"Top loci dataframe:\", shap_top.shape)\n","\n","display(perf_df.head())\n","display(shap_all.head())\n","\n","\n","# ------------------------------------------------------------\n","# 3. Helper function for saving figures\n","# ------------------------------------------------------------\n","\n","def save_fig(name):\n","    png_path = fig_dir / f\"{name}.png\"\n","    pdf_path = fig_dir / f\"{name}.pdf\"\n","    plt.tight_layout()\n","    plt.savefig(png_path, dpi=600, bbox_inches=\"tight\")\n","    plt.savefig(pdf_path, bbox_inches=\"tight\")\n","    print(f\"Saved: {png_path}\")\n","    print(f\"Saved: {pdf_path}\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. Check column names\n","# ------------------------------------------------------------\n","\n","print(\"\\nPerformance columns:\")\n","print(perf_df.columns.tolist())\n","\n","print(\"\\nSHAP columns:\")\n","print(shap_all.columns.tolist())\n","\n","\n","# ------------------------------------------------------------\n","# 5. Performance over the 50 splits\n","# ------------------------------------------------------------\n","\n","# Adjust these names only if your dataframe uses slightly different metric names\n","possible_metrics = [\n","    \"roc_auc\",\n","    \"balanced_accuracy\",\n","    \"accuracy\",\n","    \"f1\",\n","    \"precision\",\n","    \"recall\"\n","]\n","\n","available_metrics = [m for m in possible_metrics if m in perf_df.columns]\n","print(\"Available performance metrics:\", available_metrics)\n","\n","# If split_id is missing, create it from row number\n","if \"split_id\" not in perf_df.columns:\n","    perf_df[\"split_id\"] = np.arange(1, len(perf_df) + 1)\n","\n","# Line plot: ROC-AUC and balanced accuracy across splits\n","main_metrics = [m for m in [\"roc_auc\", \"balanced_accuracy\"] if m in perf_df.columns]\n","\n","plt.figure(figsize=(7, 4.5))\n","\n","for metric in main_metrics:\n","    plt.plot(\n","        perf_df[\"split_id\"],\n","        perf_df[metric],\n","        marker=\"o\",\n","        linewidth=1.4,\n","        markersize=3,\n","        label=metric.replace(\"_\", \" \").title()\n","    )\n","\n","plt.xlabel(\"Outer split\")\n","plt.ylabel(\"Held-out performance\")\n","plt.ylim(0.80, 1.00)\n","plt.title(\"Tuned XGBoost performance across 50 held-out splits\")\n","plt.legend(frameon=False)\n","plt.grid(axis=\"y\", alpha=0.3)\n","\n","save_fig(\"xgboost_performance_over_50_splits\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 6. Performance distribution boxplot\n","# ------------------------------------------------------------\n","\n","plot_metrics = [m for m in [\"roc_auc\", \"balanced_accuracy\", \"accuracy\", \"f1\", \"precision\", \"recall\"] if m in perf_df.columns]\n","\n","plt.figure(figsize=(7.5, 4.5))\n","\n","data = [perf_df[m].dropna().values for m in plot_metrics]\n","\n","plt.boxplot(\n","    data,\n","    labels=[m.replace(\"_\", \"\\n\").title() for m in plot_metrics],\n","    showmeans=True\n",")\n","\n","plt.ylabel(\"Held-out performance\")\n","plt.ylim(0.80, 1.00)\n","plt.title(\"Distribution of tuned XGBoost performance across 50 splits\")\n","plt.grid(axis=\"y\", alpha=0.3)\n","\n","save_fig(\"xgboost_performance_boxplot\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 7. ROC-AUC vs balanced accuracy scatter\n","# ------------------------------------------------------------\n","\n","if {\"roc_auc\", \"balanced_accuracy\"}.issubset(perf_df.columns):\n","\n","    plt.figure(figsize=(5, 5))\n","\n","    plt.scatter(\n","        perf_df[\"roc_auc\"],\n","        perf_df[\"balanced_accuracy\"],\n","        s=45,\n","        alpha=0.8\n","    )\n","\n","    plt.xlabel(\"Held-out ROC-AUC\")\n","    plt.ylabel(\"Held-out balanced accuracy\")\n","    plt.title(\"Tuned XGBoost split-level performance\")\n","    plt.xlim(0.90, 1.00)\n","    plt.ylim(0.80, 0.96)\n","    plt.grid(alpha=0.3)\n","\n","    save_fig(\"xgboost_roc_auc_vs_balanced_accuracy\")\n","    plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 8. Top SHAP loci bar plot\n","# ------------------------------------------------------------\n","\n","top_n = 20\n","top_shap = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(top_n).copy()\n","top_shap = top_shap.iloc[::-1]  # reverse for horizontal plotting\n","\n","plt.figure(figsize=(7, 6))\n","\n","plt.barh(\n","    top_shap[\"locus\"],\n","    top_shap[\"mean_abs_shap_mean\"],\n","    xerr=top_shap[\"mean_abs_shap_sd\"],\n","    capsize=2\n",")\n","\n","plt.xlabel(\"Mean absolute SHAP value\")\n","plt.ylabel(\"wgMLST locus\")\n","plt.title(f\"Top {top_n} SHAP-ranked loci\")\n","plt.grid(axis=\"x\", alpha=0.3)\n","\n","save_fig(\"top_20_shap_loci_mean_abs_shap\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 9. Top SHAP loci with enrichment direction\n","# ------------------------------------------------------------\n","\n","top_n = 20\n","top_dir = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(top_n).copy()\n","top_dir = top_dir.iloc[::-1]\n","\n","# Use simple numeric mapping for direction.\n","# No custom colors, so matplotlib defaults are used.\n","direction_code = top_dir[\"enriched_in\"].map({\"Animal\": -1, \"Human\": 1}).fillna(0)\n","\n","plt.figure(figsize=(7, 6))\n","\n","plt.barh(\n","    top_dir[\"locus\"],\n","    top_dir[\"mean_abs_shap_mean\"],\n","    xerr=top_dir[\"mean_abs_shap_sd\"],\n","    capsize=2\n",")\n","\n","for i, (_, row) in enumerate(top_dir.iterrows()):\n","    label = row[\"enriched_in\"]\n","    plt.text(\n","        row[\"mean_abs_shap_mean\"] + row[\"mean_abs_shap_sd\"] + 0.01,\n","        i,\n","        label,\n","        va=\"center\",\n","        fontsize=8\n","    )\n","\n","plt.xlabel(\"Mean absolute SHAP value\")\n","plt.ylabel(\"wgMLST locus\")\n","plt.title(f\"Top {top_n} SHAP loci with enrichment direction\")\n","plt.grid(axis=\"x\", alpha=0.3)\n","\n","save_fig(\"top_20_shap_loci_with_enrichment\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 10. Human vs animal presence frequency for top SHAP loci\n","# ------------------------------------------------------------\n","\n","top_n = 20\n","freq_df = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(top_n).copy()\n","freq_df = freq_df.iloc[::-1]\n","\n","y_pos = np.arange(len(freq_df))\n","\n","plt.figure(figsize=(7, 6))\n","\n","plt.plot(freq_df[\"human_presence_frequency\"], y_pos, \"o\", label=\"Human\")\n","plt.plot(freq_df[\"animal_presence_frequency\"], y_pos, \"o\", label=\"Animal\")\n","\n","for i, row in enumerate(freq_df.itertuples()):\n","    plt.plot(\n","        [row.human_presence_frequency, row.animal_presence_frequency],\n","        [i, i],\n","        linewidth=1\n","    )\n","\n","plt.yticks(y_pos, freq_df[\"locus\"])\n","plt.xlabel(\"Presence frequency\")\n","plt.ylabel(\"wgMLST locus\")\n","plt.title(f\"Presence frequency of top {top_n} SHAP loci\")\n","plt.xlim(0, 1)\n","plt.legend(frameon=False)\n","plt.grid(axis=\"x\", alpha=0.3)\n","\n","save_fig(\"top_20_shap_loci_human_vs_animal_frequency\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 11. SHAP stability plot: importance vs frequency in top 50\n","# ------------------------------------------------------------\n","\n","plt.figure(figsize=(6, 5))\n","\n","plt.scatter(\n","    shap_all[\"mean_abs_shap_mean\"],\n","    shap_all[\"proportion_top_50\"],\n","    s=25,\n","    alpha=0.7\n",")\n","\n","# Label only top 10 loci\n","label_df = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(10)\n","\n","for _, row in label_df.iterrows():\n","    plt.text(\n","        row[\"mean_abs_shap_mean\"],\n","        row[\"proportion_top_50\"] + 0.015,\n","        row[\"locus\"],\n","        fontsize=7,\n","        ha=\"center\"\n","    )\n","\n","plt.xlabel(\"Mean absolute SHAP value\")\n","plt.ylabel(\"Proportion of splits in top 50\")\n","plt.title(\"SHAP importance and stability across 50 splits\")\n","plt.ylim(-0.02, 1.08)\n","plt.grid(alpha=0.3)\n","\n","save_fig(\"shap_importance_vs_stability_top50\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 12. Rank stability for top 20 loci\n","# ------------------------------------------------------------\n","\n","top_loci = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(20)[\"locus\"].tolist()\n","\n","rank_df = shap_by_split[shap_by_split[\"locus\"].isin(top_loci)].copy()\n","\n","# Expected columns are split_id, locus, rank or mean_rank-like.\n","# If rank column is not called \"rank\", infer from available columns.\n","print(\"\\nSHAP-by-split columns:\")\n","print(rank_df.columns.tolist())\n","\n","rank_col = None\n","for candidate in [\"rank\", \"shap_rank\", \"mean_rank\", \"rank_within_split\"]:\n","    if candidate in rank_df.columns:\n","        rank_col = candidate\n","        break\n","\n","if rank_col is not None and \"split_id\" in rank_df.columns:\n","\n","    rank_pivot = rank_df.pivot(index=\"locus\", columns=\"split_id\", values=rank_col)\n","    rank_pivot = rank_pivot.loc[top_loci]\n","\n","    plt.figure(figsize=(9, 6))\n","    plt.imshow(rank_pivot, aspect=\"auto\")\n","    plt.colorbar(label=\"Rank within split\")\n","    plt.yticks(np.arange(len(rank_pivot.index)), rank_pivot.index)\n","    plt.xticks(\n","        ticks=np.arange(0, len(rank_pivot.columns), 5),\n","        labels=rank_pivot.columns[::5]\n","    )\n","    plt.xlabel(\"Outer split\")\n","    plt.ylabel(\"wgMLST locus\")\n","    plt.title(\"Rank stability of top SHAP loci across 50 splits\")\n","\n","    save_fig(\"top_20_shap_rank_stability_heatmap\")\n","    plt.show()\n","\n","else:\n","    print(\"Could not make rank heatmap because no rank column was found in shap_by_split.\")\n","\n","\n","# ------------------------------------------------------------\n","# 13. Enrichment difference plot for top SHAP loci\n","# ------------------------------------------------------------\n","\n","top_n = 20\n","enrich_df = shap_all.sort_values(\"mean_abs_shap_mean\", ascending=False).head(top_n).copy()\n","enrich_df = enrich_df.sort_values(\"human_minus_animal_presence_frequency\")\n","\n","plt.figure(figsize=(7, 6))\n","\n","plt.barh(\n","    enrich_df[\"locus\"],\n","    enrich_df[\"human_minus_animal_presence_frequency\"]\n",")\n","\n","plt.axvline(0, linewidth=1)\n","plt.xlabel(\"Human minus animal presence frequency\")\n","plt.ylabel(\"wgMLST locus\")\n","plt.title(f\"Direction of enrichment among top {top_n} SHAP loci\")\n","plt.grid(axis=\"x\", alpha=0.3)\n","\n","save_fig(\"top_20_shap_loci_enrichment_difference\")\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 14. Save compact table for article/supplement\n","# ------------------------------------------------------------\n","\n","article_table_cols = [\n","    \"locus\",\n","    \"mean_abs_shap_mean\",\n","    \"mean_abs_shap_sd\",\n","    \"mean_rank\",\n","    \"median_rank\",\n","    \"frequency_top_10\",\n","    \"frequency_top_25\",\n","    \"frequency_top_50\",\n","    \"frequency_top_100\",\n","    \"human_presence_frequency\",\n","    \"animal_presence_frequency\",\n","    \"human_minus_animal_presence_frequency\",\n","    \"enriched_in\"\n","]\n","\n","article_table_cols = [c for c in article_table_cols if c in shap_all.columns]\n","\n","article_top30 = (\n","    shap_all\n","    .sort_values(\"mean_abs_shap_mean\", ascending=False)\n","    .head(30)\n","    [article_table_cols]\n",")\n","\n","article_table_path = fig_dir / \"top_30_shap_loci_article_table.tsv\"\n","article_top30.to_csv(article_table_path, sep=\"\\t\", index=False)\n","\n","print(f\"Saved article table: {article_table_path}\")\n","display(article_top30)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"4Re9C0Wt0vC2"},"outputs
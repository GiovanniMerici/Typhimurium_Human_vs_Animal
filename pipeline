cending=[True, False, False, False, True]\n","        )\n","        .drop_duplicates(\"locus\", keep=\"first\")\n","        .reset_index(drop=True)\n","    )\n","\n","human_best = keep_best_hit(human_coords)\n","animal_best = keep_best_hit(animal_coords)\n","\n","human_best.to_csv(os.path.join(SPATIAL_DIR, \"human_enriched_best_blast_hits.csv\"), index=False)\n","animal_best.to_csv(os.path.join(SPATIAL_DIR, \"animal_enriched_best_blast_hits.csv\"), index=False)"],"metadata":{"id":"s7_aBQt9LvvL","executionInfo":{"status":"ok","timestamp":1784293883766,"user_tz":-120,"elapsed":27,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"}}},"execution_count":74,"outputs":[]},{"cell_type":"code","source":["# ----------------------------\n","# 2. Calculate neighboring distances\n","# ----------------------------\n","\n","def add_neighbor_distances(df):\n","    df = df.copy()\n","    df = df.sort_values([\"sseqid\", \"genome_start\", \"genome_end\"]).reset_index(drop=True)\n","\n","    df[\"next_locus\"] = df.groupby(\"sseqid\")[\"locus\"].shift(-1)\n","    df[\"next_start\"] = df.groupby(\"sseqid\")[\"genome_start\"].shift(-1)\n","    df[\"next_end\"] = df.groupby(\"sseqid\")[\"genome_end\"].shift(-1)\n","\n","    df[\"distance_to_next_bp\"] = df[\"next_start\"] - df[\"genome_end\"]\n","\n","    # If genes overlap, distance becomes negative. Set overlaps to 0.\n","    df[\"distance_to_next_bp\"] = df[\"distance_to_next_bp\"].clip(lower=0)\n","\n","    return df\n","\n","human_distances = add_neighbor_distances(human_best)\n","animal_distances = add_neighbor_distances(animal_best)\n","\n","human_distances.to_csv(os.path.join(SPATIAL_DIR, \"human_enriched_neighbor_distances.csv\"), index=False)\n","animal_distances.to_csv(os.path.join(SPATIAL_DIR, \"animal_enriched_neighbor_distances.csv\"), index=False)"],"metadata":{"id":"p57p-flaL3jz","executionInfo":{"status":"ok","timestamp":1784293887043,"user_tz":-120,"elapsed":23,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"}}},"execution_count":75,"outputs":[]},{"cell_type":"code","source":["# ----------------------------\n","# 3. Define spatial clusters\n","# ----------------------------\n","\n","CLUSTER_DISTANCE_BP = 10_000\n","\n","def assign_clusters(df, group_name, max_distance=10_000):\n","    df = df.copy()\n","    df = df.sort_values([\"sseqid\", \"genome_start\", \"genome_end\"]).reset_index(drop=True)\n","\n","    cluster_ids = []\n","    current_cluster = 0\n","    previous_contig = None\n","    previous_end = None\n","\n","    for _, row in df.iterrows():\n","        same_contig = row[\"sseqid\"] == previous_contig\n","\n","        if previous_end is None or not same_contig:\n","            current_cluster += 1\n","        else:\n","            distance = row[\"genome_start\"] - previous_end\n","            if distance > max_distance:\n","                current_cluster += 1\n","\n","        cluster_ids.append(f\"{group_name}_cluster_{current_cluster}\")\n","\n","        previous_contig = row[\"sseqid\"]\n","        previous_end = row[\"genome_end\"]\n","\n","    df[\"cluster_id\"] = cluster_ids\n","    df[\"cluster_distance_threshold_bp\"] = max_distance\n","\n","    return df\n","\n","human_clustered = assign_clusters(human_best, \"human\", CLUSTER_DISTANCE_BP)\n","animal_clustered = assign_clusters(animal_best, \"animal\", CLUSTER_DISTANCE_BP)\n","\n","human_clustered.to_csv(os.path.join(SPATIAL_DIR, \"human_enriched_spatial_clusters.csv\"), index=False)\n","animal_clustered.to_csv(os.path.join(SPATIAL_DIR, \"animal_enriched_spatial_clusters.csv\"), index=False)"],"metadata":{"id":"ikDnxfclL5JY","executionInfo":{"status":"ok","timestamp":1784293909137,"user_tz":-120,"elapsed":36,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"}}},"execution_count":76,"outputs":[]},{"cell_type":"code","source":["# ----------------------------\n","# 4. Summarize clusters\n","# ----------------------------\n","\n","def summarize_clusters(df):\n","    summary = (\n","        df.groupby([\"cluster_id\", \"sseqid\"])\n","        .agg(\n","            n_loci=(\"locus\", \"nunique\"),\n","            cluster_start=(\"genome_start\", \"min\"),\n","            cluster_end=(\"genome_end\", \"max\"),\n","            loci=(\"locus\", lambda x: \";\".join(x))\n","        )\n","        .reset_index()\n","    )\n","\n","    summary[\"cluster_size_bp\"] = summary[\"cluster_end\"] - summary[\"cluster_start\"] + 1\n","\n","    return summary.sort_values([\"n_loci\", \"cluster_size_bp\"], ascending=[False, True])\n","\n","human_cluster_summary = summarize_clusters(human_clustered)\n","animal_cluster_summary = summarize_clusters(animal_clustered)\n","\n","human_cluster_summary.to_csv(\n","    os.path.join(SPATIAL_DIR, \"human_enriched_cluster_summary.csv\"),\n","    index=False\n",")\n","\n","animal_cluster_summary.to_csv(\n","    os.path.join(SPATIAL_DIR, \"animal_enriched_cluster_summary.csv\"),\n","    index=False\n",")\n","\n","human_cluster_summary.head()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":226},"id":"Nzz1a_TxL6jq","executionInfo":{"status":"ok","timestamp":1784293917733,"user_tz":-120,"elapsed":84,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"}},"outputId":"2871d089-6969-48db-bded-8f3b8f88a6e4"},"execution_count":77,"outputs":[{"output_type":"execute_result","data":{"text/plain":["          cluster_id       sseqid  n_loci  cluster_start  cluster_end  \\\n","26   human_cluster_9  NC_003197.2      11        1116370      1125932   \n","22   human_cluster_5  NC_003197.2       6         786077       793674   \n","3   human_cluster_12  NC_003197.2       5        2165290      2170895   \n","24   human_cluster_7  NC_003197.2       4         976815       981882   \n","9   human_cluster_18  NC_003197.2       3        3910819      3913509   \n","\n","                                                 loci  cluster_size_bp  \n","26  STMMW_10411;STMMW_10421;STMMW_1
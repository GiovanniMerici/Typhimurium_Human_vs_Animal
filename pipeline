\"]\n","].drop_duplicates(\"locus\").copy()\n","\n","emb_meta_df = emb_meta_df.merge(\n","    desc_df,\n","    on=\"locus\",\n","    how=\"left\"\n",")\n","\n","emb_meta_df[\"Description\"] = emb_meta_df[\"Description\"].fillna(\"No description available\")\n","\n","# -----------------------------\n","# Classify hypothetical / unknown proteins\n","# -----------------------------\n","\n","unknown_patterns = [\n","    \"hypothetical\",\n","    \"unknown\",\n","    \"unnamed\",\n","    \"uncharacterized\",\n","    \"uncharacterized\",\n","    \"putative protein\",\n","    \"conserved protein\",\n","    \"domain of unknown function\",\n","    \"duf\",\n","]\n","\n","pattern_regex = \"|\".join(unknown_patterns)\n","\n","emb_meta_df[\"annotation_class\"] = np.where(\n","    emb_meta_df[\"Description\"].str.lower().str.contains(pattern_regex, regex=True, na=False),\n","    \"hypothetical_or_unknown\",\n","    \"annotated\"\n",")\n","\n","print()\n","print(\"Annotation class counts:\")\n","print(emb_meta_df[\"annotation_class\"].value_counts())\n","\n","emb_meta_df.to_csv(OUT_ALL_WITH_DESC, sep=\"\\t\", index=False)\n","print(f\"Saved metadata table to: {OUT_ALL_WITH_DESC}\")\n","\n","# -----------------------------\n","# Split embeddings\n","# -----------------------------\n","\n","unknown_meta = emb_meta_df[\n","    emb_meta_df[\"annotation_class\"] == \"hypothetical_or_unknown\"\n","].copy()\n","\n","annotated_meta = emb_meta_df[\n","    emb_meta_df[\"annotation_class\"] == \"annotated\"\n","].copy()\n","\n","X_unknown = X[unknown_meta[\"embedding_index\"].to_numpy()]\n","X_annotated = X[annotated_meta[\"embedding_index\"].to_numpy()]\n","\n","print()\n","print(\"Unknown/hypothetical embeddings:\", X_unknown.shape)\n","print(\"Annotated embeddings:\", X_annotated.shape)\n","\n","# -----------------------------\n","# Cosine similarity neighbours\n","# -----------------------------\n","\n","top_k = 10\n","\n","similarity = cosine_similarity(X_unknown, X_annotated)\n","\n",
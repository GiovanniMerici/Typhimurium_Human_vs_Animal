---------------------------\n","meta = pd.read_csv(meta_path, sep=\"\\t\", low_memory=False)\n","wgmlstid = pd.read_csv(wgmlstid_path, sep=\"\\t\", low_memory=False)\n","assembly = pd.read_csv(assembly_path, sep=\"\\t\", low_memory=False)\n","wgmlst = pd.read_csv(wgmlst_path, sep=\"\\t\", low_memory=False)\n","\n","print(\"Loaded files\")\n","print(\"Metadata rows:\", len(meta))\n","print(\"wgMLST ID rows:\", len(wgmlstid))\n","print(\"Assembly rows:\", len(assembly))\n","print(\"wgMLST rows:\", len(wgmlst))\n","\n","# -----------------------------\n","# Add Assembly Barcode to metadata\n","# -----------------------------\n","meta[\"Assembly Barcode\"] = meta[\"Uberstrain\"].map(\n","    dict(zip(assembly[\"Uberstrain\"], assembly[\"Assembly Barcode\"]))\n",")\n","\n","print(\"\\nAssembly Barcode check\")\n","print(\"Missing Assembly Barcode:\", meta[\"Assembly Barcode\"].isna().sum())\n","\n","# -----------------------------\n","# Add wgMLST ID to metadata\n","# -----------------------------\n","meta[\"wgmlst_id\"] = meta[\"Uberstrain\"].map(\n","    dict(zip(wgmlstid[\"Uberstrain\"], wgmlstid[\"ST\"]))\n",")\n","\n","print(\"\\nwgMLST ID check in metadata\")\n","print(\"Missing wgmlst_id:\", meta[\"wgmlst_id\"].isna().sum())\n","\n","# -----------------------------\n","# Rename ST columns clearly\n","# -----------------------------\n","meta = meta.rename(columns={\"ST\": \"MLST_ST\"})\n","wgmlst = wgmlst.rename(columns={\"ST\": \"wgmlst_id\"})\n","\n","# Stop if IDs are missing\n","if meta[\"wgmlst_id\"].isna().any():\n","    raise ValueError(\"Some metadata rows are missing wgmlst_id.\")\n","\n","if wgmlst[\"wgmlst_id\"].isna().any():\n","    raise ValueError(\"Some wgMLST rows are missing wgmlst_id.\")\n","\n","# Standardize merge key\n","meta[\"wgmlst_id\"] = meta[\"wgmlst_id\"].astype(str).str.strip()\n","wgmlst[\"wgmlst_id\"] = wgmlst[\"wgmlst_id\"].astype(str).str.strip()\n","\n","# -----------------------------\n","# Check duplicate wgmlst_id\n","# -----------------------------\n","print(\"\\nDuplicate wgmlst_id check\")\n","print(\"Metadata rows:\", len(meta))\n","print(\"Unique metadata wgmlst_id:\", meta[\"wgmlst_id\"].nunique())\n","print(\"Duplicated metadata wgmlst_id rows:\", meta[\"wgmlst_id\"].duplicated(keep=False).sum())\n","\n","print(\"wgMLST rows:\", len(wgmlst))\n","print(\"Unique wgMLST wgmlst_id:\", wgmlst[\"wgmlst_id\"].nunique())\n","print(\"Duplicated wgMLST wgmlst_id rows:\", wgmlst[\"wgmlst_id\"].duplicated(keep=False).sum())\n","\n","# -----------------------------\n","# Check that duplicated wgmlst_id rows in wgMLST have identical allele profiles\n","# -----------------------------\n","wgmlst_for_merge = wgmlst.drop(columns=[\"Name\"], errors=\"ignore\").copy()\n","\n","duplicated_profiles = wgmlst_for_merge[\n","    wgmlst_for_merge[\"wgmlst_id\"].duplicated(keep=False)\n","].copy()\n","\n","profile_cols = [col for col in wgmlst_for_merge.columns if col != \"wgmlst_id\"]\n","\n","if len(duplicated_profiles) > 0:\n","    n_unique_profiles_per_id = (\n","        duplicated_profiles\n","        .groupby(\"wgmlst_id\")[profile_cols]\n","        .nunique(dropna=False)\n","        .max(axis=1)\n","    )\n","\n","    problem_ids = n_unique_profiles_per_id[n_unique_profiles_per_id > 1]\n","\n","    print(\"\\nDuplicated wgmlst_id values with non-identical allele profiles:\", len(problem_ids))\n","\n","    if len(problem_ids) > 0:\n","        print(problem_ids)\n","        raise ValueError(\"Some duplicated wgmlst_id values have different allele profiles.\")\n","else:\n","    print(\"\\nNo duplicated wgmlst_id rows in wgMLST table.\")\n","\n","# -----------------------------\n","# Remove redundant metadata rows with duplicate wgmlst_id\n","# -----------------------------\n","meta_duplicate_wgmlst_id = meta[\n","    meta[\"wgmlst_id\"].duplicated(keep=False)\n","].copy()\n","\n","print(\"\\nMetadata duplicate wgmlst_id rows to review/remove:\", len(meta_duplicate_wgmlst_id))\n","\n","if len(meta_duplicate_wgmlst_id) > 0:\n","    print(\n","        meta_duplicate_wgmlst_id[\n","            [\"wgmlst_id\", \"Uberstrain\", \"Name\", \"Assembly Barcode\", \"MLST_ST\"]\n","        ]\n","        .sort_values(\"wgmlst_id\")\n","        .to_string()\n","    )\n","\n","    meta_duplicate_wgmlst_id.to_csv(\n","        removed_path,\n","        sep=\"\\t\",\n","        index=False\n","    )\n","\n","    print(\"Saved removed duplicate rows to:\", removed_path)\n","\n","# Keep one representative isolate per wgmlst_id\n","meta_unique = meta.drop_duplicates(\n","    subset=[\"wgmlst_id\"],\n","    keep=\"first\"\n",").copy()\n","\n","# Keep one allele profile per wgmlst_id\n","wgmlst_unique = wgmlst_for_merge.drop_duplicates(\n","    subset=[\"wgmlst_id\"],\n","    keep=\"first\"\n",").copy()\n","\n","print(\"\\nAfter removing duplicate wgmlst_id\")\n","print(\"Original metadata rows:\", len(meta))\n","print(\"Metadata rows kept:\", len(meta_unique))\n","print(\"Metadata rows removed:\", len(meta) - len(meta_unique))\n","print(\"Unique wgMLST profiles kept:\", len(wgmlst_unique))\n","\n","# -----------------------------\n","# Merge one metadata row to one wgMLST profile\n","# -----------------------------\n","merged = meta_unique.merge(\n","    wgmlst_unique,\n","    on=\"wgmlst_id\",\n","    how=\"left\",\n","    validate=\"one_to_one\"\n",")\n","\n","print(\"\\nMerge check\")\n","print(\"Merged rows:\", len(merged))\n","\n","allele_cols = [col for col in wgmlst_unique.columns if col != \"wgmlst_id\"]\n","missing_wgmlst = merged[allele_cols].isna().all(axis=1).sum()\n","\n","print(\"Rows without wgMLST match:\", missing_wgmlst)\n","\n","if missing_wgmlst > 0:\n","    print(\n","        merged.loc[\n","            merged[allele_cols].isna().all(axis=1),\n","            [\"Uberstrain\", \"Name\", \"Assembly Barcode\", \"wgmlst_id\"]\n","        ]\n","    )\n","\n","# -----------------------------\n","# Move key columns to the front\n","# -----------------------------\n","front_c
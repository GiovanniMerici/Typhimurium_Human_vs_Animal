"/content/drive/MyDrive/Salmonella_typhimurium_NA\")\n","\n","ESM3_DIR = PROJECT_DIR / \"esm3\"\n","INPUT_DIR = ESM3_DIR / \"input\"\n","OUTPUT_DIR = ESM3_DIR / \"output\"\n","RESIDUE_EMB_DIR = OUTPUT_DIR / \"residue_embeddings\"\n","QC_DIR = ESM3_DIR / \"qc\"\n","\n","for d in [INPUT_DIR, OUTPUT_DIR, RESIDUE_EMB_DIR, QC_DIR]:\n","    d.mkdir(parents=True, exist_ok=True)\n","\n","INPUT_TSV = INPUT_DIR / \"esm3_input_valid_bacterial_starts.tsv\"\n","INPUT_CSV = INPUT_DIR / \"esm3_input_valid_bacterial_starts.csv\"\n","\n","MEAN_EMB_TSV = OUTPUT_DIR / \"esm3_mean_pooled_embeddings.tsv\"\n","MEAN_EMB_NPY = OUTPUT_DIR / \"esm3_mean_pooled_embeddings.npy\"\n","MEAN_EMB_LOCI = OUTPUT_DIR / \"esm3_mean_pooled_embedding_loci.txt\"\n","\n","FAILED_TSV = QC_DIR / \"esm3_failed_sequences.tsv\"\n","RUN_INFO_JSON = QC_DIR / \"esm3_embedding_run_info.json\"\n","\n","# -----------------------------\n","# Save input dataframe\n","# -----------------------------\n","\n","esm3_input_df = esm3_input_df.copy()\n","\n","esm3_input_df.to_csv(INPUT_TSV, sep=\"\\t\", index=False)\n","esm3_input_df.to_csv(INPUT_CSV, index=False)\n","\n","print(f\"Saved ESM3 input TSV to: {INPUT_TSV}\")\n","print(f\"Saved ESM3 input CSV to: {INPUT_CSV}\")\n","print(f\"Input sequences: {len(esm3_input_df)}\")\n","\n","# -----------------------------\n","# Load ESM3 model\n","# -----------------------------\n","\n","DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(\"Using device:\", DEVICE)\n","\n","model = ESM3.from_pretrained(\"esm3_sm_open_v1\").to(DEVICE)\n","model.eval()\n","\n","print(\"ESM3 model loaded\")\n","\n","# -----------------------------\n","# Generate embeddings\n","# -----------------------------\n","\n","mean_embedding_records = []\n","mean_embedding_arrays = []\n","failed_records = []\n","\n","completed_loci = {\n","    p.stem.replace(\"_residue_embeddings\", \"\")\n","    for p in RESIDUE_EMB_DIR.glob(\"*_residue_embeddings.npz\")\n","}\n","\n","print(f\"Already completed residue embedding files: {len(completed_loci)}\")\n","\n","for row in tqdm(esm3_input_df.itertuples(index=False), total=len(esm3_input_df), desc=\"Generating ESM3 embeddings\"):\n","    locus = row.locus\n","    seq = str(row.protein_sequence)\n","\n","    out_npz = RESIDUE_EMB_DIR / f\"{locus}_residue_embeddings.npz\"\n","\n","    try:\n","        # If already done, load existing residue embeddings and compute mean again\n","        if out_npz.exists():\n","            data = np.load(out_npz)\n","            residue_embeddings = data[\"residue_embeddings\"]\n","        else:\n","            protein = ESMProtein(sequence=seq)\n","\n","            with torch.no_grad():\n","                encoded = model.encode(protein)\n","                encoded = encoded.to(DEVICE)\n","\n","                logits_output = model.logits(\n","                    encoded,\n","                    LogitsConfig(\n","                        sequence=True,\n","                        return_embeddings=True\n","                    )\n","                )\n","\n","                embeddings = logits_output.embeddings\n","\n","                # Shape is usually: [1, L + special tokens, hidden_dim]\n","                embeddings = embeddings.detach().cpu()\n","\n","                if embeddings.ndim == 3:\n","                    embeddings = embeddings.squeeze(0)\n","\n","                # Remove special tokens.\n","                # For ESM3 this is generally BOS at position 0 and EOS after the sequence.\n","                residue_embeddings = embeddings[1:len(seq) + 1].numpy()\n","\n","            np.savez_compressed(\n","                out_npz,\n","                locus=locus,\n","                protein_sequence=seq,\n","                residue_embeddings=residue_embeddings\n","            )\n","\n","        mean_embedding = residue_embeddings.mean(axis=0)\n","\n","        mean_embedding_records.append({\n","            \"locus\": locus,\n","            \"protein_sequence\": seq,\n","            \"protein_length_aa\": len(seq),\n","            \"residue_embedding_shape\": str(residue_embeddings.shape),\n","            \"mean_embedding_dim\": len(mean_embedding),\n","        })\n","\n","        mean_embedding_arrays.append(mean_embedding)\n","\n","    except Exception as e:\n","        failed_records.append({\n","            \"locus\": locus,\n","            \"protein_sequence\": seq,\n","            \"protein_length_aa\": len(seq),\n","            \"error_type\": type(e).__name__,\n","            \"error_message\": str(e),\n","        })\n","\n","# -----------------------------\n","# Save mean-pooled embeddings\n","# -----------------------------\n","\n","mean_embedding_metadata_df = pd.DataFrame(mean_embedding_records)\n","\n","if len(mean_embedding_arrays) > 0:\n","    mean_embedding_matrix = np.vstack(mean_embedding_arrays)\n","\n","    emb_cols = [f\"esm3_emb_{i}\" for i in range(mean_embedding_matrix.shape[1])]\n","    mean_embedding_values_df = pd.DataFrame(mean_embedding_matrix, columns=emb_cols)\n","\n","    mean_embedding_df = pd.concat(\n","        [\n","            mean_embedding_metadata_df.reset_index(drop=True),\n","            mean_embedding_values_df.reset_index(drop=True)\n","        ],\n","        axis=1\n","    )\n","\n","    mean_embedding_df.to_csv(MEAN_EMB_TSV, sep=\"\\t\", index=False)\n","    np.save(MEAN_EMB_NPY, mean_embedding_matrix)\n","\n","    with open(MEAN_EMB_LOCI, \"w\") as f:\n","        for locus in mean_embedding_metadata_df[\"locus\"]:\n","            f.write(str(locus) + \"\\n\")\n","\n","    print(f\"Saved mean-pooled embeddings TSV to: {MEAN_EMB_TSV}\")\n","    print(f\"Saved mean-pooled embeddings matrix to: {MEAN_EMB_NPY}\")\n","    print(f\"Saved locus order to: {MEAN_EMB_LOCI}\")\n","    print(f\"Mean embedding matrix shape: {mean_embedding_matrix.shape}\")\n","\n","else:\n","    print(\"No embeddings were successfully generated.\")\n","\n","# -----------------------------\n","# Save failures and run info\n","# -----------------------------\n","\n","failed_df = pd.DataFrame(failed_records)\n","failed_df.to_csv(FAILED_TSV, sep=\"\\t\", index=False)\n","\n","run_info = {\n","    \"model\": \"esm3_sm_open_v1\",\n","    \"device\": DEVICE,\n","    \"input_tsv\": str(INPUT_TSV),\n","    \"input_sequences\": len(esm3_input_df),\n","    \"successful_embeddings\": len(mean_embedding_records),\n","    \"failed_embeddings\": len(failed_records),\n","    \"residue_embedding_dir\": str(RESIDUE_EMB_DIR),\n","    \"mean_pooled_embeddings_tsv\": str(MEAN_EMB_TSV),\n","    \"mean_pooled_embeddings_npy\": str(MEAN_EMB_NPY),\n","    \"mean_pooled_locus_order\": str(MEAN_EMB_LOCI),\n","    \"method_note\": (\n","        \"Protein sequences translated from allele-1 bacterial CDSs were embedded with ESM3. \"\n","        \"Residue-level embeddings were extracted after removing special tokens. \"\n","        \"Mean-pooled embeddings were calculated by averaging residue embeddings across amino-acid positions.\"\n","    )\n","}\n","\n","with open(RUN_INFO_JSON, \"w\") as f:\n","    json.dump(run_info, f, indent=4)\n","\n","print(f\"Saved failed sequence report to: {FAILED_TSV}\")\n","print(f\"Saved run info to: {RUN_INFO_JSON}\")\n","print()\n","print(\"Successful:\", len(mean_embedding_records))\n","print(\"Failed:\", len(failed_records))\n","\n","if len(failed_df) > 0:\n","    display(failed_df.head())"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":568},"executionInfo":{"elapsed":9087,"status":"ok","timestamp":1784109954379,"user":{"displayName":"Giovanni Merici","userId":"15342373927499361078"},"user_tz":-120},"id":"LtgfjhDrIK1d","outputId":"d740aef0-5ba5-4bfc-dda1-f768e41e5453"},"outputs":[{"name":"stdout","output_type":"stream","text":["Embedding dataframe shape before merge: (1759, 1541)\n","Embedding loci: 1759\n","Description loci: 1774\n","Saved embeddings with description TSV to: /content/drive/MyDrive/Salmonel